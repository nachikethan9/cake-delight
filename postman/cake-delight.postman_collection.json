    {
      "name": "E2E Journey",
      "description": "Run this folder with the Collection Runner: browse -> filter -> basket -> checkout -> notification -> rating. Creates a fresh user each run.",
      "item": [
        {
          "name": "1. Browse cakes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cakes?size=20&available=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cakes"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "available",
                  "value": "true"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"e2eUser\", \"demo\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const cakes = pm.response.json().content;",
                  "pm.test(\"At least 2 available cakes\", () => pm.expect(cakes.length).to.be.at.least(2));",
                  "pm.collectionVariables.set(\"e2eCake1\", cakes[0].id);",
                  "pm.collectionVariables.set(\"e2eCake2\", cakes[1].id);"
                ]
              }
            }
          ]
